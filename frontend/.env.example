# Variaveis de ambiente do frontend (Vite). Copie para .env.local e ajuste.
# So as variaveis com prefixo VITE_ chegam ao navegador: NUNCA coloque aqui segredos
# (chaves privadas, senhas, tokens). Tudo o que esta aqui fica publico no codigo da pagina.

# URL do backend REST (sem barra final).
VITE_API_URL=http://localhost:3001

# Client ID do projeto no painel do Web3Auth (https://dashboard.web3auth.io).
# Vazio + VITE_REDE_LOCAL=true -> modo de desenvolvimento: a carteira do estudante e gerada
# no navegador e guardada em localStorage ("votacao.carteiraDev"), sem Web3Auth.
# Vazio + VITE_REDE_LOCAL diferente de true -> erro de configuracao.
VITE_WEB3AUTH_CLIENT_ID=

# Rede do Web3Auth: sapphire_devnet (testes) ou sapphire_mainnet (producao).
# Tem de corresponder a rede do projeto no painel do Web3Auth.
VITE_WEB3AUTH_REDE=sapphire_devnet

# true  -> contrato num no local (Hardhat, chainId 31337) em VITE_RPC_LOCAL.
#          Com Web3Auth, a chave e exportada e as transacoes sao assinadas na propria pagina
#          (o Chrome bloqueia o acesso do site do Web3Auth a rede local). Requer a exportacao
#          de chaves ativa no painel do Web3Auth.
# false -> contrato na Sepolia (chainId 11155111) em VITE_RPC_SEPOLIA; a assinatura e feita
#          pelo provider do Web3Auth.
VITE_REDE_LOCAL=true

# RPC do no local (npx hardhat node).
VITE_RPC_LOCAL=http://127.0.0.1:8545

# RPC da Sepolia (ex.: Infura, Alchemy ou https://ethereum-sepolia-rpc.publicnode.com).
# Obrigatorio quando VITE_REDE_LOCAL=false.
VITE_RPC_SEPOLIA=

# Opcional: endereco do contrato. Se definido, sobrepoe-se ao de src/contrato/Votacao.json.
VITE_ENDERECO_CONTRATO=
