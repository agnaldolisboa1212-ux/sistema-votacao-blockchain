# Configuração do backend. Copie este ficheiro para .env e ajuste os valores.
# O .env nunca deve ser partilhado nem posto no repositório (está no .gitignore).

# --- Servidor HTTP ---
# Porta onde a API escuta (as rotas ficam em http://localhost:PORTA/api).
PORTA=3001
# Origem do frontend autorizada pelo CORS. Várias origens separadas por vírgulas.
CORS_ORIGEM=http://localhost:5173

# --- Base de dados MySQL ---
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_UTILIZADOR=root
# Vazio por omissão, como no WAMP.
DB_SENHA=
DB_NOME=votacao
# Os estudantes de teste criados por `npm run bd:criar` usam todos a senha: Teste@2026

# --- Autenticação ---
# Segredo para assinar os tokens JWT (HS256). Obrigatório, com pelo menos 32 caracteres.
# Gere um valor aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# --- Blockchain ---
# URL do node JSON-RPC (o "npx hardhat node" escuta em http://127.0.0.1:8545).
RPC_URL=http://127.0.0.1:8545
# Chave privada da conta administradora (a que publicou o contrato). Paga o gás da habilitação
# e chama registarEleitor. Sem ela o servidor arranca, mas a habilitação devolve 503.
#
# ATENÇÃO: o valor abaixo é a chave da conta #0 do Hardhat. É PÚBLICA E BEM CONHECIDA, serve
# apenas para desenvolvimento local e NUNCA se usa numa rede real (testnet ou mainnet):
# qualquer pessoa pode gastar os fundos de uma conta com esta chave.
CHAVE_ADMIN=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# ETH enviado a cada carteira habilitada para pagar o gás do voto.
VALOR_GAS_ETH=0.01
# Opcional: endereço do contrato. Se definido, sobrepõe-se ao de src/contrato/Votacao.json.
ENDERECO_CONTRATO=
# Intervalo (ms) entre rondas de cópia dos eventos VotoRegistado para logs_votacao (mínimo 1000).
INTERVALO_SINCRONIZACAO_MS=5000
